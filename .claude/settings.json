{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "echo \"[SessionStart] syncing wiki from origin...\"; git -C \"${CLAUDE_PROJECT_DIR:-.}\" pull 2>&1 || echo \"[SessionStart] git pull failed (offline or conflict) - continuing without blocking\"",
            "timeout": 30,
            "statusMessage": "Синхронизация вики с GitHub..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Read(//c/jarvis/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git pull *)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(python .claude/skills/wiki-ingest/scripts/ingest.py *)",
      "Bash(python .claude/skills/wiki-lint/scripts/lint_wiki.py *)",
      "WebSearch",
      "WebFetch(domain:context7.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:claude.ai)",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__plugin_playwright_playwright__browser_console_messages",
      "mcp__plugin_playwright_playwright__browser_find",
      "mcp__plugin_playwright_playwright__browser_hover",
      "mcp__plugin_playwright_playwright__browser_resize"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(pip install*)",
      "Bash(pnpm add*)",
      "Bash(yarn add*)",
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}
